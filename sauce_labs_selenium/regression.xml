<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Suite" parallel="tests">
  <groups>
    <run>
      <include name="Regression"></include>
    </run>
  </groups>
<listeners>
  <listener class-name="com.aditya.test_components.Listeners"></listener>
</listeners>
  <test thread-count="5" name="Purchase Order Test" >
    <classes>
      <class name="com.aditya.tests.StandaloneTestCopy"/>
    </classes>
  </test>
  <test thread-count="5" name="Error Validation Test" >
    <classes>
      <class name="com.aditya.tests.ErrorValidationsTest"/>
    </classes>
  </test>
</suite>
